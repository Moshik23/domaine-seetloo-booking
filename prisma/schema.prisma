// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Venue {
  HALL
  CHALET
  BOTH
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Booking {
  id                String        @id @default(cuid())

  // Customer / form header
  formDate          String? // "YYYY-MM-DD" - the "Date" field at top of paper form
  surname           String
  otherNames        String
  phone1            String
  phone2            String?
  address           String?

  // Overall occupancy / lodging window (Date In / Check In / Date Out / Check Out)
  dateIn            String // "YYYY-MM-DD"
  timeIn            String? // "HH:mm" - Check In time
  dateOut           String // "YYYY-MM-DD"
  timeOut           String? // "HH:mm" - Check Out time
  occupancyVenue    Venue // which venue(s) the dateIn-dateOut window itself blocks

  // Money (whole MUR)
  agreedPrice       Int
  deposit           Int // non-refundable, captured at creation, immutable

  status            BookingStatus @default(CONFIRMED)
  bookedByStaffName String        @default("Ramdeo Seetloo")
  notes             String?

  events            BookingEvent[]
  payments          Payment[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, dateIn, dateOut])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  label     String // e.g. "Geet Gawai", "Reception" - preset or free text, venue NOT embedded in text
  venue     Venue
  date      String // "YYYY-MM-DD"
  startTime String // "HH:mm"
  endTime   String? // "HH:mm" - null = informational marker only, not an occupancy block

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
}

model Payment {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount    Int // whole MUR
  date      String // "YYYY-MM-DD"
  note      String?

  createdAt DateTime @default(now())

  @@index([bookingId])
}
